cc_library_shared {
    name: "libgrallocutils",
    defaults: ["display_defaults"],
    vendor: true,
    srcs: [
        "gr_utils.cpp",
        "gr_adreno_info.cpp",
    ],
    shared_libs: [
        "libqdMetaData",
        "libdl",
        "android.hardware.graphics.common@1.1",
    ],
    cflags: [
        "-DLOG_TAG=\"grallocutils\"",
        "-Wno-sign-conversion",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
    ] + select(soong_config_variable("TARGET_KERNEL_VERSION", "4.14"), {
        "true": [
            "-I$(LIBION_HEADER_PATHS)",
            "-I/system/core/libion/include",
            "-I/system/core/libion/kernel-headers/",
        ],
        default: [],
    }) + select(soong_config_variable("TARGET_KERNEL_VERSION", "4.19"), {
        "true": ["-I$(LIBION_HEADER_PATHS)"],
        default: [],
    }),

    header_libs: [
        "display_headers",
        "qti_kernel_headers",
    ],
}
